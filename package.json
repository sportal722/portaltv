{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "node scripts/setup-db.mjs",
    "test:api": "node scripts/test-api.mjs",
    "admin:promote": "node --env-file=.env --import tsx scripts/promote-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "6.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
