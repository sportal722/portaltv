generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  twoFactorSecret String?
  twoFactorLastCounter Int @default(-1)
  recoveryCodes String @default("[]")
  twoFactorSetup TwoFactorSetup?
  passwordHash String
  role String @default("viewer")
  status String @default("active")
  createdAt DateTime @default(now())
  sessions Session[]
  streams Stream[]
  follows Follow[]
  messages ChatMessage[]
  moderations ChannelModerator[]
  bans ChannelBan[]
  notifications LiveNotification[]
}
model Session {
  id String @unique @default(cuid())
  createdAt DateTime @default(now())
  userAgent String @default("")
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Stream {
  id Int @id @default(autoincrement())
  slug String @unique
  legacySlug String? @unique
  ownerId String
  title String
  game String
  category String
  image String @default("channel")
  avatar Int @default(0)
  tag String @default("Comunidad")
  isSuspended Boolean @default(false)
  suspensionReason String @default("")
  isDemo Boolean @default(false)
  description String @default("")
  language String @default("Español")
  thumbnailUrl String @default("")
  status String @default("offline")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  follows Follow[]
  messages ChatMessage[]
  credential StreamCredential?
  moderators ChannelModerator[]
  bans ChannelBan[]
  chatSettings ChatSettings?
  commands ChatCommand[]
  alertSettings AlertSettings?
  activities ActivityEvent[]
  audit AuditEvent[]
  liveState LiveState?
  notifications LiveNotification[]
  @@index([ownerId])
  @@index([category])
}
model Follow {
  notifyLive Boolean @default(true)
  userId String
  streamId Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@id([userId, streamId])
  @@index([streamId])
}
model ChatMessage {
  id Int @id @default(autoincrement())
  userId String
  streamId Int
  text String
  scope String @default("public")
  isBot Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@index([streamId, id])
  @@index([userId])
}
model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model StreamCredential {
  streamId Int @id
  path String @unique
  keyHash String
  updatedAt DateTime @updatedAt
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
}

model ChannelModerator {
  streamId Int
  userId String
  createdAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([streamId, userId])
  @@index([userId])
}
model ChannelBan {
  streamId Int
  userId String
  reason String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([streamId, userId])
}
model ChatSettings {
  streamId Int @id
  slowSeconds Int @default(0)
  followersOnly Boolean @default(false)
  blockLinks Boolean @default(false)
  blockedWords String @default("")
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
}
model ChatCommand {
  id Int @id @default(autoincrement())
  streamId Int
  name String
  response String
  cooldownSeconds Int @default(30)
  moderatorsOnly Boolean @default(false)
  enabled Boolean @default(true)
  lastUsedAt DateTime?
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@unique([streamId, name])
}
model AlertSettings {
  streamId Int @id
  followersEnabled Boolean @default(true)
  template String @default("¡Gracias por seguir el canal, {user}!")
  accent String @default("#a78bfa")
  durationSeconds Int @default(6)
  soundEnabled Boolean @default(false)
  tokenHash String?
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
}
model ActivityEvent {
  id Int @id @default(autoincrement())
  streamId Int
  kind String
  username String
  createdAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@index([streamId, id])
}
model AuditEvent {
  id Int @id @default(autoincrement())
  streamId Int?
  actorId String
  actorName String
  action String
  target String
  createdAt DateTime @default(now())
  stream Stream? @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@index([streamId, id])
}

model TwoFactorSetup {
  userId String @id
  secret String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id String @id @default("main")
  registrationOpen Boolean @default(true)
  announcement String @default("")
}
model Report {
  id Int @id @default(autoincrement())
  reporterId String
  streamId Int
  reason String
  description String
  status String @default("open")
  resolution String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, id])
}

model LiveState {
  streamId Int @id
  lastSeenAt DateTime
  startedAt DateTime
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
}
model LiveNotification {
  id Int @id @default(autoincrement())
  userId String
  streamId Int
  startedAt DateTime
  title String
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@unique([userId, streamId, startedAt])
  @@index([userId, id])
}
