# Inside the cloudcraft.mx site block, before the web fallback.
handle_path /media/* {
    @mediaFiles path_regexp mediaFiles ^/[a-f0-9]{32}/[a-f0-9]{16}/(thumbnail\.jpg|hls/(index\.m3u8|segment_[0-9]+\.ts)|dash/(manifest\.mpd|(init|chunk)-stream[0-9]+(-[0-9]+)?\.webm))$
    handle @mediaFiles {
        root * /srv/nexora/media/public
        header Cache-Control "public, max-age=30"
        header X-Content-Type-Options nosniff
        @manifest path *.m3u8 *.mpd
        header @manifest Cache-Control no-store
        @dash path *.mpd
        header @dash Content-Type application/dash+xml
        @hls path *.m3u8
        header @hls Content-Type application/vnd.apple.mpegurl
        @thumb path */thumbnail.jpg
        header @thumb Cache-Control "public, max-age=5"
        file_server
    }
    respond 404
}
